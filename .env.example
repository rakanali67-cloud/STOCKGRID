# StockGrid — environment variables template
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains real secrets.

# development | production
# NOTE: with FLASK_ENV=production the app REFUSES to start unless
# STOCKGRID_SECRET_KEY and STOCKGRID_DB_PASSWORD are set — no insecure defaults.
FLASK_ENV=development

# Required in production. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
STOCKGRID_SECRET_KEY=change-me-to-a-long-random-string
STOCKGRID_DB_HOST=localhost
STOCKGRID_DB_USER=root
STOCKGRID_DB_PASSWORD=
STOCKGRID_DB_NAME=stockgrid
STOCKGRID_DB_POOL_SIZE=32

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# In production the SMTP password MUST come from here — the app ignores any
# password stored in the app_settings table so a DB leak cannot expose it.
STOCKGRID_SMTP_HOST=
STOCKGRID_SMTP_PORT=587
STOCKGRID_SMTP_USER=
STOCKGRID_SMTP_PASS=
STOCKGRID_SMTP_FROM=

# ── Tuning ────────────────────────────────────────────────────────────────────
# Each open dashboard holds one SSE connection. Cap concurrency and lifetime so
# a burst of tabs cannot starve normal requests.
STOCKGRID_MAX_SSE_STREAMS=20
STOCKGRID_SSE_MAX_SECONDS=300
# Optional dedicated pepper for API-key hashing (defaults to STOCKGRID_SECRET_KEY)
STOCKGRID_API_PEPPER=

# ── Google OAuth 2.0 (Login with Google) ─────────────────────────────────────
# Get these from https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID → Web application type
# Authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Cloud (Storage, Vision, Sheets) ───────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=
GOOGLE_CLOUD_PROJECT=

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_ADMIN_CREDENTIALS=

# ── AI Providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
