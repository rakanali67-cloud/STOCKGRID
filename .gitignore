# Environment — never commit real credentials
.env

# Database dumps — these contain live customer records (names, emails, phone
# numbers). Committing one would put personal data into git history
# permanently, where it survives deleting the file afterwards.
backups/
*.sql.gz
!db/*.sql

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Runtime logs
*.log
srv_log.txt

# Virtual environments
venv/
.venv/
env/

# AI / ML artefacts
*.pkl
*.joblib
*.h5
# Anchored to the repository root. Written as a bare `models/` this matched
# any directory of that name at any depth, which silently excluded
# app/ai/models/ — seven source files that app/ai/engine.py imports at
# runtime. A clone of the repository had no AI models package at all and
# raised ImportError as soon as a forecasting feature was used.
/models/

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# Office lock/temp files (created while a .docx or .html is open in Word)
~$*

# Trained model artefacts — regenerated by the AI trainer, not source
ai_model_store/
